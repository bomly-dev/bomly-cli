#!/usr/bin/env sh
#
# The unit suite gates a push. Everything slower runs elsewhere: lint, vet,
# both builds and the generated-docs drift run in CI on the pull request, and
# the network-driven smoke suite runs in CI once the pull request is approved. `make verify`
# runs the CI checks locally when you want them.
#
# To push without testing, say so out loud: `git push --no-verify`.
set -eu

# Git exports its own location (GIT_DIR and friends) to a hook, and from a
# linked worktree those are absolute paths. The suite builds throwaway
# repositories and runs git inside them; with the variables inherited, those
# commands address this repository instead and fail with "this operation must
# be run in a work tree". Clearing them is what git documents for a hook that
# runs git elsewhere, and it lets the suite run as it does from a terminal.
# shellcheck disable=SC2046 # the variable names are meant to split
unset $(git rev-parse --local-env-vars)

make test
