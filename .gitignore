# Ignore macOS system files
.DS_Store

# Ignore build files
/bin

# Ignore generated third-party license notices (bundled into release archives)
/licenses

# Ignore generated SBOM files
/sboms

# Ignore local assurance report previews
/.assurance

# Ignore local dependency graph benchmark artifacts
/.benchmark-runs

# Ignore test coverage files
coverage

# IDE files
.idea

# Claude worktrees
/.claude/worktrees

# Qodana files
qodana.yaml

# Local scratch notes (not tracked)
/notes

# npm wrapper artifacts (the binary is fetched by its postinstall step)
/npm/vendor
/npm/node_modules
/npm/*.tgz

# Copied from the repo root by npm/scripts/prepack.js at pack time
/npm/LICENSE
/npm/NOTICE

# accidental root-level build outputs
/bomly
/bomly-lite
