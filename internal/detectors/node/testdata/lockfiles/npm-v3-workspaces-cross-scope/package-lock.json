{
  "name": "cross-scope-workspace",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "packages": {
    "": {
      "name": "cross-scope-workspace",
      "version": "1.0.0",
      "workspaces": ["apps/*", "packages/*"]
    },
    "apps/web": {
      "name": "web",
      "version": "0.2.0",
      "devDependencies": {
        "shared-tool": "^1.0.0"
      }
    },
    "packages/lib": {
      "name": "lib",
      "version": "1.0.0",
      "dependencies": {
        "runtime-dep": "^2.0.0"
      }
    },
    "node_modules/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/lib": {
      "resolved": "packages/lib",
      "link": true
    },
    "node_modules/runtime-dep": {
      "version": "2.0.0",
      "resolved": "https://registry.npmjs.org/runtime-dep/-/runtime-dep-2.0.0.tgz",
      "license": "MIT",
      "dependencies": {
        "shared-tool": "^1.0.0"
      }
    },
    "node_modules/shared-tool": {
      "version": "1.0.0",
      "resolved": "https://registry.npmjs.org/shared-tool/-/shared-tool-1.0.0.tgz",
      "license": "MIT"
    }
  }
}
